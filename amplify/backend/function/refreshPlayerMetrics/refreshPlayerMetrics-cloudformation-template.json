          "Ref": "CloudWatchRule"
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "LambdaFunction",
                "Arn"
              ]
            },
            "Id": {
              "Ref": "LambdaFunction"
            },
            "Input": "{\"source\":\"aws.events\",\"triggerType\":\"SCHEDULED\",\"fullRefresh\":true}"
          }
        ]
      }
    },
